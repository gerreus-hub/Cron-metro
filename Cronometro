// ===== LÓGICA OCULTA PARA CAMBIAR EL TIEMPO =====
let lapClickCount = 0;
let lastClickTime = 0;
let targetCS = 472; // Valor inicial (el que ya tenías)

// Modificamos la función handleLap existente para incluir el truco
const originalHandleLap = handleLap;
handleLap = function() {
  const now = Date.now();
  
  // Detectar triple clic (menos de 500ms entre clics)
  if (now - lastClickTime < 500) {
    lapClickCount++;
  } else {
    lapClickCount = 1;
  }
  lastClickTime = now;

  if (lapClickCount === 3) {
    // Ventana oculta para setear el tiempo
    let nuevoTiempo = prompt("Setear tiempo de detención (en centésimas):", targetCS);
    if (nuevoTiempo !== null) {
      targetCS = parseInt(nuevoTiempo);
      lapClickCount = 0; // Resetear contador
      return; // Salimos para que no marque una "vuelta" accidental al configurar
    }
  }
  
  // Si no es triple clic, ejecuta la función original
  originalHandleLap();
};

// Sobrescribimos la lógica de parada para que use nuestra variable dinámica targetCS
const originalHandleStartStop = handleStartStop;
handleStartStop = function() {
  if (!running) {
    // Si estamos iniciando, usamos la lógica original
    originalHandleStartStop();
  } else {
    // Si estamos deteniendo, aplicamos el truco con el tiempo dinámico
    running = false;
    cancelAnimationFrame(rafId);
    elapsed = targetCS; 
    const str = formatTime(targetCS);
    timerDigital.textContent = str;
    timerDial.textContent    = str;
    updateNeedle(targetCS);
    btnStart.textContent = 'Iniciar';
    btnStart.classList.remove('running');
    btnLap.textContent = 'Restab.';
    btnLap.style.color = 'rgba(255,255,255,0.52)';
  }
};
